# Copy to deploy/memecreator.env on the server and fill in. Never commit memecreator.env (it is gitignored).
# Lines left commented out are simply not set.

# People signing in with this email are admins
MEME_ADMIN_EMAILS=hamid70yazdi@gmail.com

# Google sign-in (Google Cloud project "Meme Creator"). Add the redirect URI
#   https://memesforlaughs.com/login/oauth2/code/google
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Facebook sign-in (Meta app "Meme Creator"). Redirect URI: https://memesforlaughs.com/login/oauth2/code/facebook
#META_APP_ID=
#META_APP_SECRET=

# Emails (sign-up confirmation, password reset). While commented out they go to the log only.
#MEME_MAIL_FROM=Memes for Laughs <no-reply@memesforlaughs.com>
#SPRING_MAIL_HOST=smtp-relay.brevo.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=
#SPRING_MAIL_PASSWORD=
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
